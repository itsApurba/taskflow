NODE_ENV=development
PORT=3939
# Long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=supersecret
JWT_EXPIRATION_MINUTES=15
# Vercel's MongoDB Atlas integration sets MONGODB_URI instead; either name works.
MONGO_URI=mongodb://localhost:27017/taskflow
# Comma-separated allowed origins, e.g. https://taskflow-one.vercel.app. Unset allows all.
# Random secret shared with the hourly scheduler; never expose in VITE_*.
DEMO_RESTORE_SECRET=
CORS_ORIGIN=
